# Public repository. Nothing here may contain a secret, an internal hostname,
# an IP address or any other fleet detail -- in a commit or in history.

/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
/public/assets
.byebug_history
/config/master.key
/config/credentials/*.key
/.kamal/secrets*
/.env*
!/.env.example
/node_modules
